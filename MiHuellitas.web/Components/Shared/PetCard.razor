@using MiHuellitas.shared.Models
@using MiHuellitas.shared.Services
@inject MockCatalogService Catalog

@if (Pet is null)
{
    <div class="pet-card-placeholder">Sin datos</div>
}
else
{
    <article class="pet-card" tabindex="0" role="article" aria-label="Mascota: @Pet.Name">
        <figure>
            <img src="@Pet.ImageUrl" alt="@Pet.Name" />
        </figure>
        <div class="pet-card-body">
                    <div class="pet-meta">
                <span class="badge @(Pet.ListingType == MiHuellitas.shared.Enums.ListingType.Lost ? "missing" : Pet.ListingType == MiHuellitas.shared.Enums.ListingType.Found ? "found" : "adoption")">@Pet.ListingType</span>
                <span>@Pet.Species</span>
                <span>@Pet.Breed</span>
            </div>
            <h3>@(string.IsNullOrWhiteSpace(Pet.Name) ? "Sin nombre" : Pet.Name)</h3>
            <p class="location">📍 @Pet.Location</p>
            @if (!string.IsNullOrWhiteSpace(Pet.Description))
            {
                <p>@(Pet.Description.Length > 140 ? Pet.Description.Substring(0, 137) + "..." : Pet.Description)</p>
            }
            <div class="card-footer-row">
                <span>@(Pet.AgeMonths) meses</span>
                <span>@Pet.Size</span>
                @if (Pet.ListingType == MiHuellitas.shared.Enums.ListingType.Lost || Pet.ListingType == MiHuellitas.shared.Enums.ListingType.Found)
                {
                    <span>• Última vez visto: @Pet.LastSeenAt.ToString("yyyy-MM-dd")</span>
                }
            </div>
            <div class="pet-actions">
                @{
                    var route = Pet.ListingType switch
                    {
                        MiHuellitas.shared.Enums.ListingType.Adoption => $"/adopciones/{Pet.Id}",
                        MiHuellitas.shared.Enums.ListingType.Lost => $"/perdidos/{Pet.Id}",
                        MiHuellitas.shared.Enums.ListingType.Found => $"/encontrados/{Pet.Id}",
                        _ => $"/adopciones/{Pet.Id}",
                    };
                }
                <a class="primary-btn" href="@route">Ver detalle</a>
                <button class="secondary-btn" @onclick="ToggleFavorite">@(Catalog.IsFavorite(Pet.Id) ? "Quitar favorito" : "Favorito")</button>
            </div>
        </div>
    </article>

    @if (showToast)
    {
        <div class="toast-notification @(toastClosing ? "closing" : "")" role="status" aria-live="polite">
            <div class="toast-content">
                <strong>Favoritos</strong>
                <div class="toast-message">@toastMessage</div>
            </div>
            <button class="toast-close" aria-label="Cerrar" @onclick="CloseToast">×</button>
        </div>
    }
}

@code {
    [Parameter]
    public Pet? Pet { get; set; }

    private bool showToast = false;
    private bool toastClosing = false;
    private string toastMessage = string.Empty;
    private CancellationTokenSource? toastCts;

    private async Task ToggleFavorite()
    {
        if (Pet is null) return;
        var nowFavorite = !Catalog.IsFavorite(Pet.Id);
        Catalog.ToggleFavorite(Pet.Id);
        toastMessage = nowFavorite ? "Mascota añadida a favoritos." : "Mascota eliminada de favoritos.";
        toastClosing = false;
        showToast = true;
        StateHasChanged();

        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(2500, toastCts.Token);
            await StartToastClose();
        }
        catch (TaskCanceledException) { }
    }

    private async Task StartToastClose()
    {
        if (!showToast || toastClosing) return;
        toastClosing = true;
        StateHasChanged();
        await Task.Delay(220);
        showToast = false;
        toastClosing = false;
        StateHasChanged();
    }

    private async Task CloseToast()
    {
        toastCts?.Cancel();
        await StartToastClose();
    }

    public void Dispose()
    {
        toastCts?.Cancel();
        toastCts?.Dispose();
    }
}