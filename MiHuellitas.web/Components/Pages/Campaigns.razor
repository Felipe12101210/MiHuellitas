@page "/campanas"
@inject MiHuellitas.shared.Services.MockCatalogService Catalog
@using MiHuellitas.shared.Models

<PageTitle>Campañas</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Acciones de impacto</p>
            <h1>Campañas</h1>
        </div>
    </header>

    @if (isLoading)
    {
        <div class="loading-state">Cargando...</div>
    }
    else if (isError)
    {
        <div class="error-state">Ocurrió un error al cargar las campañas. Intenta más tarde.</div>
    }
    else
    {
        <div class="filters-row">
            <label>
                Título
                <input @bind="searchTitle" @bind:event="oninput" @bind:after="ResetPagination" class="form-control" placeholder="Buscar por título" />
            </label>

            <label>
                Ubicación
                <input @bind="searchLocation" @bind:event="oninput" @bind:after="ResetPagination" class="form-control" placeholder="Buscar por ubicación" />
            </label>

            <button class="secondary-btn" @onclick="ClearFilters">Limpiar</button>
        </div>

        <div class="cards-grid">
            @if (Filtered.Any())
            {
                @foreach (var campaign in Filtered.Take(pageSize))
                {
                    <article class="campaign-card">
                        <img src="@campaign.ImageUrl" alt="@campaign.Title" />
                        <div class="pet-card-body">
                            <div class="pet-meta">
                                <span class="badge found">@campaign.Status</span>
                            </div>
                            <h3>@campaign.Title</h3>
                            <p class="location">📍 @campaign.Location</p>
                            <p>@campaign.Description</p>
                            <div class="card-footer-row">
                                <span>@campaign.Organizer</span>
                                <span>@campaign.EventDate.ToString("dd MMM yyyy")</span>
                            </div>
                            <div class="pet-actions">
                                <a class="primary-btn" href="/campanas/@campaign.Id">Ver detalle</a>
                            </div>
                        </div>
                    </article>
                }

                @if (Filtered.Count() > pageSize)
                {
                    <div class="load-more">
                        <button class="primary-btn" @onclick="LoadMore">Cargar más</button>
                    </div>
                }
            }
            else
            {
                <div class="empty-state">No se encontraron campañas que coincidan con los filtros.</div>
            }
        </div>
    }
</section>

@code {
    private string searchTitle = string.Empty;
    private string searchLocation = string.Empty;

    private List<Campaign> localCampaigns = new();
    private bool isLoading = true;
    private bool isError = false;

    private IEnumerable<Campaign> Filtered => localCampaigns
        .Where(c => string.IsNullOrEmpty(searchTitle) || c.Title.Contains(searchTitle, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrEmpty(searchLocation) || c.Location.Contains(searchLocation, StringComparison.OrdinalIgnoreCase))
        .ToList();

    private int pageSize = 6;

    private void LoadMore() => pageSize += 6;

    private void ResetPagination() => pageSize = 6;

    private void ClearFilters()
    {
        searchTitle = string.Empty;
        searchLocation = string.Empty;
        pageSize = 6;
    }

    protected override async Task OnInitializedAsync()
    {
        isLoading = true;
        isError = false;
        try
        {
            await Task.Yield();
            localCampaigns = Catalog.GetCampaigns().ToList();
        }
        catch
        {
            isError = true;
        }
        finally
        {
            isLoading = false;
        }
    }
}
