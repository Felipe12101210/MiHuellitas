@page "/notificaciones"
@inject MiHuellitas.shared.Services.MockCatalogService Catalog
@implements IDisposable

<PageTitle>Notificaciones</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Actualizaciones importantes</p>
            <h1>Notificaciones</h1>
        </div>
    </header>

    <div class="notification-list">
        @if (!Catalog.Notifications.Any())
        {
            <div class="empty-state">No hay notificaciones.</div>
        }
        else
        {
            @foreach (var notification in Catalog.Notifications)
            {
                <article class="notification-item @(notification.IsRead ? "read" : "unread")">
                    <div class="notification-badge">@notification.Type</div>
                    <div>
                        <h3>@notification.Title</h3>
                        <p>@notification.Message</p>
                        <small>@notification.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                    </div>
                    <div class="notification-actions">
                        @if (!notification.IsRead)
                        {
                            <button class="secondary-btn" @onclick="() => MarkRead(notification.Id)">Marcar leída</button>
                        }
                        <button class="danger-btn" @onclick="() => DeleteNotification(notification.Id)">Eliminar</button>
                    </div>
                </article>
            }
        }
    </div>
</section>

@code {
    protected override void OnInitialized()
    {
        Catalog.NotificationsChanged += OnNotificationsChanged;
    }

    private void OnNotificationsChanged()
    {
        // ensure UI updates on the Blazor render thread
        InvokeAsync(StateHasChanged);
    }

    private void MarkRead(int id)
    {
        Catalog.MarkNotificationRead(id);
    }

    private void DeleteNotification(int id)
    {
        Catalog.RemoveNotification(id);
    }

    public void Dispose()
    {
        Catalog.NotificationsChanged -= OnNotificationsChanged;
    }
}
