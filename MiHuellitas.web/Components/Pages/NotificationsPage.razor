@page "/notificaciones"
@inject MiHuellitas.shared.Services.MockCatalogService Catalog
@implements IDisposable

<PageTitle>Notificaciones</PageTitle>

<section class="page-shell">
    <header class="page-header">
        <div>
            <p class="eyebrow">Actualizaciones importantes</p>
            <h1>Notificaciones</h1>
        </div>
    </header>

    <div class="notification-list">
        @if (!Catalog.Notifications.Any())
        {
            <div class="empty-state">No hay notificaciones.</div>
        }
        else
        {
            @foreach (var notification in Catalog.Notifications)
            {
                <article class="notification-item @(notification.IsRead ? "read" : "unread")">
                    <div class="notification-badge">@notification.Type</div>
                    <div>
                        <h3>@notification.Title</h3>
                        <p>@notification.Message</p>
                        <small>@notification.CreatedAt.ToString("dd MMM yyyy, HH:mm")</small>
                    </div>
                    <div class="notification-actions">
                        @if (!notification.IsRead)
                        {
                            <button class="secondary-btn" @onclick="() => MarkRead(notification.Id)">Marcar leída</button>
                        }
                        <button class="danger-btn" @onclick="() => DeleteNotification(notification.Id)">Eliminar</button>
                    </div>
                </article>
            }
        }
    </div>

    @if (showToast)
    {
        <div class="toast-notification @(toastClosing ? "closing" : "")" role="status" aria-live="polite">
            <div class="toast-content">
                <strong>Notificaciones</strong>
                <div class="toast-message">@toastMessage</div>
            </div>
            <button class="toast-close" aria-label="Cerrar" @onclick="CloseToast">×</button>
        </div>
    }
</section>

@code {
    private bool showToast = false;
    private bool toastClosing = false;
    private string toastMessage = string.Empty;
    private CancellationTokenSource? toastCts;

    protected override void OnInitialized()
    {
        Catalog.NotificationsChanged += OnNotificationsChanged;
    }

    private void OnNotificationsChanged()
    {
        // ensure UI updates on the Blazor render thread
        InvokeAsync(StateHasChanged);
    }

    private async Task MarkRead(int id)
    {
        Catalog.MarkNotificationRead(id);
        toastMessage = "Notificación marcada como leída.";
        ShowToast();
    }

    private void DeleteNotification(int id)
    {
        Catalog.RemoveNotification(id);
    }

    private void ShowToast()
    {
        toastClosing = false;
        showToast = true;
        toastCts?.Cancel();
        toastCts = new CancellationTokenSource();
        _ = HideToastAfterDelay(toastCts.Token);
    }

    private async Task HideToastAfterDelay(CancellationToken token)
    {
        try
        {
            await Task.Delay(2500, token);
            if (!showToast || toastClosing) return;
            toastClosing = true;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(220);
            showToast = false;
            toastClosing = false;
            await InvokeAsync(StateHasChanged);
        }
        catch (TaskCanceledException) { }
    }

    private async Task CloseToast()
    {
        toastCts?.Cancel();
        if (!showToast || toastClosing) return;
        toastClosing = true;
        StateHasChanged();
        await Task.Delay(220);
        showToast = false;
        toastClosing = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        Catalog.NotificationsChanged -= OnNotificationsChanged;
        toastCts?.Cancel();
        toastCts?.Dispose();
    }
}
