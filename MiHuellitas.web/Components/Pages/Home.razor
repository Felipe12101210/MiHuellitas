@page "/"
@using MiHuellitas.shared.Models


<main>
    <section class="replay-video">
        <video autoplay muted loop playsinline>
            <source src="videos/Video1_MH.mp4" type="video/mp4">
        </video>
    </section>

    <section class="cards">
        <div class="cards-item">
            <h1>¿Que quieres hacer hoy?</h1>
            <div class="cards-content">
                @foreach(var card in cards){
                <div class="cards-content-card">
                   <div class="cards-content-img">
                        <img src="@card.img" alt="@card.title">
                   </div> 
                   <div class="cards-content-text">
                        <h3>@card.title</h3>
                        <p>@card.description</p>
                   </div>
                   <div class="cards-content-button">
                        <button>@card.button</button>
                   </div>
                </div>
            }
            </div>
            
        </div>
    </section>

    <section>
        <About/>
    </section>
    
    <section>
        <Process></Process>
    </section>

    <section>
        <FormPet></FormPet>
    </section>

</main>


