@page "/campanas/{Id:int}"
@inject MiHuellitas.shared.Services.MockCatalogService Catalog
@using MiHuellitas.shared.Models

<PageTitle>Detalle campaña</PageTitle>

@{
    var campaign = Catalog.GetCampaignById(Id);
}

@if (campaign is null)
{
    <section class="page-shell">
        <h2>Campaña no encontrada</h2>
        <p>La campaña solicitada no existe.</p>
        <a class="secondary-btn" href="/campanas">Volver a campañas</a>
    </section>
}
else
{
    <section class="page-shell detail-shell">
        <div class="detail-grid">
            <div class="detail-media">
                <img src="@campaign.ImageUrl" alt="@campaign.Title" />
            </div>
            <div class="detail-body">
                <h1>@campaign.Title</h1>
                <div class="pet-meta">
                    <span>@campaign.Organizer</span>
                    <span class="badge found">@campaign.Status</span>
                </div>

                <p class="location">📍 @campaign.Location</p>
                <p>@campaign.Description</p>

                <div class="card-footer-row">
                    <strong>Fecha:</strong> @campaign.EventDate.ToString("f")
                </div>

                <a class="primary-btn" href="/campanas">Volver</a>
            </div>
        </div>
    </section>
}

@code {
    [Parameter]
    public int Id { get; set; }
}