<footer class="site-footer">
    <div>
        <h3>Mi Huellitas</h3>
        <p>Una comunidad para proteger y acompañar animales en riesgo.</p>
    </div>

    <div>
        <h4>Secciones</h4>
        <ul>
            <li><a href="/adopciones">Adopciones</a></li>
            <li><a href="/perdidos">Perdidos</a></li>
            <li><a href="/fundaciones">Fundaciones</a></li>
            <li><a href="/campanas">Campañas</a></li>
        </ul>
    </div>

    <div class="footer-contacto">
        <h4>Contáctanos</h4>
        <label>Correo</label>
        <input type="email" placeholder="tucorreo@ejemplo.com" @bind="contactEmail" />
        <button @onclick="SendContact">Enviar</button>
        @if (!string.IsNullOrEmpty(contactMessage))
        {
            <p class="footer-contacto-msg">@contactMessage</p>
        }
    </div>
</footer>

@code {
    private string contactEmail = string.Empty;
    private string contactMessage = string.Empty;

    private void SendContact()
    {
        contactMessage = "Gracias — nos pondremos en contacto contigo.";
    }
}